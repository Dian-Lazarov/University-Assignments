@{
    ViewData["Title"] = "Пици";
}

<section class="py-4">
    <h2 class="mb-4">Пици</h2>
    
    <div class="row g-4">
        <!-- Pizza Card 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Асорти', 12.99, 'Класическа пица', '/images/pizzas/asorti.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/pizzas/asorti.png" alt="Асорти" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Асорти</h5>
                    <p class="card-text text-muted"><b>Съставки:</b> доматен сос, моцарела, шунка, сирене, ч. лук, маслини, пушена шунка, бяло сирене, домати, пресен пипер</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">12.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Асорти', 12.99, 'Класическа пица', '/images/pizzas/asorti.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pizza Card 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Атина', 14.99, 'Пица Атина', '/images/pizzas/atina.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/pizzas/atina.png" alt="Атина" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Атина</h5>
                    <p class="card-text text-muted"><b>Съставки:</b> доматен сос, английски бекон, шпек, печен пипер, гъби, маслини, кисели краставички, кашкавал, топено сирене, домат</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">14.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Атина', 14.99, 'Пица Атина', '/images/pizzas/atina.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

