                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">14.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Рене', 14.99, 'Пица Рене', '/images/pizzas/rene.png')" title="Добави в количката">
