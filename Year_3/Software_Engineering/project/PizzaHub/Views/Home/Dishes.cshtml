@{
    ViewData["Title"] = "Ястия";
}

<section class="py-4">
    <h2 class="mb-4">Ястия</h2>
    
    <div class="row g-4">
        <!-- Dish 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Хрупкави пилешки филета с корнфлейкс и чеснов сос', 11.99, 'Пилешко ястие', '/images/dishes/hapki.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/dishes/hapki.png" alt="Пилешки филета" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Хрупкави пилешки филета с корнфлейкс и чеснов сос</h5>
                    <p class="card-text text-muted"></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">11.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Хрупкави пилешки филета с корнфлейкс и чеснов сос', 11.99, 'Пилешко ястие', '/images/dishes/hapki.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dish 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Пилешки крилца', 9.99, 'Пилешко ястие', '/images/dishes/krilca.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/dishes/krilca.png" alt="Пилешки крилца" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Пилешки крилца</h5>
                    <p class="card-text text-muted"></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">9.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Пилешки крилца', 9.99, 'Пилешко ястие', '/images/dishes/krilca.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dish 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Ориз със зеленцуци', 10.99, 'Вегетарианско ястие', '/images/dishes/rice.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/dishes/rice.png" alt="Ориз със зеленчуци" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Ориз със зеленцуци</h5>
                    <p class="card-text text-muted"></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">10.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Ориз със зеленцуци', 10.99, 'Вегетарианско ястие', '/images/dishes/rice.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
