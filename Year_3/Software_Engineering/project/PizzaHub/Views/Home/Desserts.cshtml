@{
    ViewData["Title"] = "Десерти";
}

<section class="py-4">
    <h2 class="mb-4">Десерти</h2>
    
    <div class="row g-4">
        <!-- Dessert 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Шоколадова пица', 6.99, 'Десерт', '/images/desserts/shokoladova_pica.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/desserts/shokoladova_pica.png" alt="Шоколадова пица" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Шоколадова пица</h5>
                    <p class="card-text text-muted">Борд пълен с десерт „twix", шоколадова Philadelphia (Milka), течен шоколад Nutella, натрошени бисквити Oreo</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">6.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Шоколадова пица', 6.99, 'Десерт', '/images/desserts/shokoladova_pica.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dessert 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Бишкотена торта', 5.99, 'Десерт', '/images/desserts/bishkotena_torta.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/desserts/bishkotena_torta.png" alt="Бишкотена торта" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Бишкотена торта</h5>
                    <p class="card-text text-muted"></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">5.99 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Бишкотена торта', 5.99, 'Десерт', '/images/desserts/bishkotena_torta.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dessert 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm position-relative">
                <button class="btn btn-link position-absolute" style="top: 10px; right: 10px; z-index: 10;" 
                        onclick="toggleFavorite('Сладоледени еклери', 5.49, 'Десерт', '/images/desserts/sladoledeni_ekleri.png'); this.querySelector('i').classList.toggle('fas'); this.querySelector('i').classList.toggle('far');" 
                        title="Добави в любими">
                    <i class="far fa-heart" style="font-size: 24px; color: #ff6b35;"></i>
                </button>
                <img src="~/images/desserts/sladoledeni_ekleri.png" alt="Сладоледени еклери" class="card-img-top" style="height: 250px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">Сладоледени еклери</h5>
                    <p class="card-text text-muted"></p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-danger">5.49 лв</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="addToCart('Сладоледени еклери', 5.49, 'Десерт', '/images/desserts/sladoledeni_ekleri.png')" title="Добави в количката">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
